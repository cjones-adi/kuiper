[Unit]
Description=ADM1600 inventory + sensor associations for bmcweb/Redfish
# The ObjectMapper must be up so it can synthesise the all_sensors/chassis
# association endpoints from the Association.Definitions this service publishes.
Requires=xyz.openbmc_project.ObjectMapper.service
After=xyz.openbmc_project.ObjectMapper.service
# Not required (pending associations self-heal once sensors appear), but start
# after the hwmon poller is set up so associations resolve promptly.
Wants=obmc-hwmon-adm1600.service
After=obmc-hwmon-adm1600.service

[Service]
Type=dbus
BusName=xyz.openbmc_project.adm1600.Inventory
ExecStart=/usr/bin/adm1600-assoc
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
